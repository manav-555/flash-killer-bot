# ══════════════════════════════════════════════════════════════════════════════
# Flash Killer Bot — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Meta / Instagram ──────────────────────────────────────────────────────────
# Random string you set in the Meta App Dashboard → Webhooks → Verify Token
IG_VERIFY_TOKEN=your_random_verify_token_here

# Long-lived Page Access Token from Meta App Dashboard
IG_PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here

# Your Instagram Business Account ID (numeric)
IG_BUSINESS_ACCOUNT_ID=123456789012345

# ── Google Gemini (AI Studio Free Tier) ──────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6Io87Dn3stJ4QPNA70AaQW2vFrtkSxiLWOVbQJYM5Efcw

# ── Groq (LLM Fallback — Free Tier) ─────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── OpenRouter (Secondary Fallback — :free models) ───────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# ── Jina Reader (Free 500 RPM) ────────────────────────────────────────────────
# https://jina.ai — optional, used to boost quality
JINA_API_KEY=jina_...

# ── Tavily Search (Free 1,000/mo) ─────────────────────────────────────────────
# https://tavily.com
TAVILY_API_KEY=tvly-...

# ── Serper.dev (Google Shopping prices) ──────────────────────────────────────
# https://serper.dev
SERPER_API_KEY=your_serper_key_here

# ── Firecrawl (Anti-bot JS pages only — /scrape endpoint only!) ───────────────
# https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# ── Supabase (pgvector) ───────────────────────────────────────────────────────
# https://supabase.com → Project Settings → API
SUPABASE_URL=https://melbpfkiuwflpmdrzamu.supabase.co/rest/v1/
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1lbGJwZmtpdXdmbHBtZHJ6YW11Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTk5OTYwMywiZXhwIjoyMTA3NTc1NjAzfQ.zpFzjIckl4u2yM8erxPsZuwtgegIBdkU-eIaUmyveRk

# ── Upstash Redis (REST client) ───────────────────────────────────────────────
# https://console.upstash.com → Redis → REST API
