UPSTASH_REDIS_REST_TOKEN=AX...

# ── App Settings ──────────────────────────────────────────────────────────────
# Environment: "development" | "production"
APP_ENV=development
# Redis TTL for cached reel verdicts (seconds) — default 24h
REEL_CACHE_TTL_SECONDS=86400
